# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/alumni_network?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# JWT Configuration
# Generate a secure Base64 encoded secret key using: openssl rand -base64 64
# Minimum 256 bits (32 bytes) required for HS256 algorithm
JWT_SECRET=your_base64_encoded_secret_key_here_minimum_256_bits_required
JWT_EXPIRATION=86400000

# Brevo API Configuration
BREVO_API_KEY=your_brevo_api_key_here

# Application Configuration
FRONTEND_URL=http://localhost:5173
MAIL_FROM_EMAIL=your_email@example.com
MAIL_FROM_NAME=Alumni Network
