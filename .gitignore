# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Environment variables
.env
.env*.local
*.env
!*.env.example

# Sensitive configuration files
**/*.secret
**/*.key
**/credentials.*
**/config/secrets.*

# Dependencies
**/node_modules/
**/.pnp
**/.pnp.js
**/package-lock.json

# Java/Maven
**/target/
**/.mvn/wrapper/maven-wrapper.jar
**/.m2/

# Build outputs
**/build/
**/dist/
**/dist-ssr/
**/*.class
**/*.jar
**/*.war
**/*.ear

# Testing
**/coverage/
**/.nyc_output/

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
**/*.iml
**/*.ipr
**/*.iws
.project
.classpath
.settings/
.factorypath
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db
*.swp
*~

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Temporary files
*.tmp
*.temp
.cache/
