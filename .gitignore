# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ====================
# Environment Variables
# ====================
.env
.env*.local
*.env
!*.env.example
!.env.example
.env.development
.env.production
.env.test

# Sensitive configuration files
**/*.secret
**/*.key
**/credentials.*
**/config/secrets.*
application-local.properties
application-local.yml

# ====================
# Dependencies
# ====================
**/node_modules/
**/.pnp
**/.pnp.js
**/package-lock.json
**/yarn.lock
**/pnpm-lock.yaml
**/.yarn/
**/.npm/

# ====================
# Java/Maven/Spring Boot
# ====================
**/target/
**/.mvn/wrapper/maven-wrapper.jar
**/.m2/
**/.mvn/timing.properties
**/.mvn/wrapper/maven-wrapper.properties
**/*.class
**/*.jar
**/*.war
**/*.ear
!**/src/main/**/target/
!**/src/test/**/target/
**/.springBeans
**/.sts4-cache
**/spring.log

# ====================
# Build Outputs
# ====================
**/build/
**/dist/
**/dist-ssr/
!**/src/main/**/build/
!**/src/test/**/build/
**/.vite/
**/vite.config.js.timestamp-*

# ====================
# Testing
# ====================
**/coverage/
**/.nyc_output/
**/.jest/
**/.vitest/
**/test-results/
**/.playwright/

# ====================
# IDE & Editors
# ====================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
**/*.iml
**/*.ipr
**/*.iws
.project
.classpath
.settings/
.factorypath
.apt_generated
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~
**/.history/

# ====================
# OS Specific
# ====================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

